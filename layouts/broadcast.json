//sets the layout for the broadcast view - a tall, narrow overlay
// Keys follow the Keysanity setting via active_keys_grid_broadcast, so they
// disappear here too when keys are not randomized.
{
	"tracker_broadcast": {
		"type": "array",
		"orientation": "vertical",
		"h_alignment": "left",
		"v_alignment": "top",
		"margin": 0,
		"content": [
			{
				"type": "group",
				"header": "Items",
				"content": {
					"type": "layout",
					"h_alignment": "center",
					"v_alignment": "center",
					"key": "shared_item_grid_compact"
				}
			},
			{
				"type": "group",
				"header": "Collectables",
				"content": {
					"type": "layout",
					"h_alignment": "center",
					"v_alignment": "center",
					"key": "collectables_grid_compact"
				}
			},
			{
				"type": "layout",
				"key": "active_keys_grid_broadcast"
			}
		]
	}
}
